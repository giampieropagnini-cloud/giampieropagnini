# originali a piena risoluzione: restano in locale (353 MB)
assets/img/
assets/thumbs/
assets/f_*.jpg
assets/hero-video-raw.mp4
# build intermedie e dati di scraping
dist/
dist-b/
dist-c/
sheets/
scrape/json/
scrape/*.html
proposte/
.DS_Store
# pagine autonome in attesa di essere copiate in docs/ da gen.py: sono solo una
# copia di lavoro, gli stessi file finiscono gia' in docs/ che e' quello pubblicato.
# L'archivio di WeedGadget si rigenera con:
#   python3 ../weedgadget-brand/scripts/pubblica-sul-sito.py
static/*
# ...tranne i prontuari dei Pocket Operator e del TP-7, che non li genera nessuno
# script: tenerli qui fa si' che gen.py --clean li rimetta in docs/ dopo una ripulita.
!static/pocket-operator/
!static/tp-7/
# Xcode: impostazioni personali e build, non vanno nel repository
bobina/**/xcuserdata/
bobina/**/*.xcuserstate
bobina/build/
DerivedData/
